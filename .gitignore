__pycache__/
*.py[cod]
*$py.class
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
dist/
build/

# Cache + run artefacts that don't belong in source control.
# The verdict cache + per-run output directories are regenerable
# from a fresh ``make run`` (or ``eval-agent recover``). Committing
# them would bloat the repo and leak per-prompt Gemini responses.
state/cache/
state/runs/*/
state/runs/*/results.jsonl.tmp
state/runs/*/.in_progress

# Debug logs (auto-pruned after 7 days; never source-control them)
state/logs/

# OS junk
.DS_Store

# IDE
.idea/
.vscode/

# Local env
.env
.env.local

# Orchestrator session artefacts — same rationale as state/runs/.
state/orchestrator/sessions/*/
